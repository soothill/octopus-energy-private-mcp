# Required for account, meter and consumption tools.
OCTOPUS_API_KEY=sk_live_replace_me
OCTOPUS_ACCOUNT_NUMBER=A-REPLACE_ME

# Europe/London is right for Octopus Energy GB accounts and DST-aware analysis.
OCTOPUS_TIMEZONE=Europe/London

# Optional IDs for documented GraphQL smart-device tools.
# Use octopus_get_smart_meter_devices for the meter EUI64 and
# octopus_get_smart_flex_devices for EV/battery/heat-pump IDs.
OCTOPUS_SMART_METER_DEVICE_ID=
OCTOPUS_SMART_FLEX_DEVICE_ID=

# Privacy and resilience defaults.
OCTOPUS_CACHE_ENABLED=true
# OCTOPUS_CACHE_DIR=/a/private/local/path
OCTOPUS_REQUESTS_PER_MINUTE=30
OCTOPUS_MIN_REQUEST_INTERVAL_MS=1000
OCTOPUS_REQUEST_TIMEOUT_MS=20000
OCTOPUS_MAX_RETRIES=3
OCTOPUS_PAGE_SIZE=1500
OCTOPUS_MAX_PAGES_PER_CALL=25
OCTOPUS_MAX_RECORDS_PER_CALL=25000

# Gas REST values are kWh for SMETS1 and m3 for SMETS2. Leave auto to avoid
# an unsafe guess, or set the unit you have confirmed for your meter.
OCTOPUS_GAS_CONSUMPTION_UNIT=auto
OCTOPUS_GAS_M3_TO_KWH_FACTOR=11.184
