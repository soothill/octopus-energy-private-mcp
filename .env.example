# Required for account, meter and consumption tools.
# With a single account these two variables are enough.
OCTOPUS_API_KEY=sk_live_replace_me
OCTOPUS_ACCOUNT_NUMBER=A-REPLACE_ME

# Optional: multiple named sites, each with its own API key and account.
# List the sites (friendly names) and define per-site variables:
#   OCTOPUS_SITE_<SLUG>_API_KEY / _ACCOUNT_NUMBER / _NAME
#   OCTOPUS_SITE_<SLUG>_SMART_METER_DEVICE_ID / _SMART_FLEX_DEVICE_ID
# <SLUG> is the site name uppercased with non-alphanumerics replaced by
# underscores ("Newport Pagnell" -> NEWPORT_PAGNELL). Tools accept a
# `site` parameter; OCTOPUS_DEFAULT_SITE selects the site used when none
# is given (defaults to the first listed site).
# OCTOPUS_SITES=York,Newport Pagnell
# OCTOPUS_DEFAULT_SITE=York
# OCTOPUS_SITE_YORK_NAME=York
# OCTOPUS_SITE_YORK_API_KEY=sk_live_york_key
# OCTOPUS_SITE_YORK_ACCOUNT_NUMBER=A-YORK0000
# OCTOPUS_SITE_NEWPORT_PAGNELL_NAME=Newport Pagnell
# OCTOPUS_SITE_NEWPORT_PAGNELL_API_KEY=sk_live_newport_key
# OCTOPUS_SITE_NEWPORT_PAGNELL_ACCOUNT_NUMBER=A-NEWPORT0

# Europe/London is right for Octopus Energy GB accounts and DST-aware analysis.
OCTOPUS_TIMEZONE=Europe/London

# Optional IDs for documented GraphQL smart-device tools.
# Use octopus_get_smart_meter_devices for the meter EUI64 and
# octopus_get_smart_flex_devices for EV/battery/heat-pump IDs.
OCTOPUS_SMART_METER_DEVICE_ID=
OCTOPUS_SMART_FLEX_DEVICE_ID=

# Privacy and resilience defaults.
OCTOPUS_CACHE_ENABLED=true
# OCTOPUS_CACHE_DIR=/a/private/local/path
# Persistent history store for offline what-if replays (lives under the cache dir).
OCTOPUS_HISTORY_ENABLED=true
# Years of consumption/rate history to backfill on the first octopus_sync_history run.
OCTOPUS_HISTORY_BACKFILL_YEARS=3
# Transport: stdio (default, for MCP clients that spawn the process) or http
# for a fixed streamable-HTTP endpoint (used when running in the mcp-hub).
# OCTOPUS_TRANSPORT=stdio
# OCTOPUS_MCP_HOST=0.0.0.0
# OCTOPUS_MCP_PORT=8070
# Optional bearer token checked on every HTTP request (set only for http).
# OCTOPUS_MCP_TOKEN=
# Set false to prevent the anonymous startup version check to api.github.com.
OCTOPUS_UPDATE_CHECK_ENABLED=true
OCTOPUS_REQUESTS_PER_MINUTE=30
OCTOPUS_MIN_REQUEST_INTERVAL_MS=1000
OCTOPUS_REQUEST_TIMEOUT_MS=20000
OCTOPUS_MAX_RETRIES=3
OCTOPUS_PAGE_SIZE=1500
OCTOPUS_MAX_PAGES_PER_CALL=25
OCTOPUS_MAX_RECORDS_PER_CALL=25000

# Gas REST values are kWh for SMETS1 and m3 for SMETS2. Leave auto to avoid
# an unsafe guess, or set the unit you have confirmed for your meter.
OCTOPUS_GAS_CONSUMPTION_UNIT=auto
OCTOPUS_GAS_M3_TO_KWH_FACTOR=11.184
