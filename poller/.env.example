# --- Octopus sites (same naming scheme as the MCP server) ---
# Comma-separated friendly names. Each needs its own key and account.
OCTOPUS_SITES=York,Newport Pagnell

OCTOPUS_SITE_YORK_NAME=York
OCTOPUS_SITE_YORK_API_KEY=sk_live_york_key
OCTOPUS_SITE_YORK_ACCOUNT_NUMBER=A-YORK0000

OCTOPUS_SITE_NEWPORT_PAGNELL_NAME=Newport Pagnell
OCTOPUS_SITE_NEWPORT_PAGNELL_API_KEY=sk_live_newport_key
OCTOPUS_SITE_NEWPORT_PAGNELL_ACCOUNT_NUMBER=A-NEWPORT0

# --- InfluxDB 2.x on the Proxmox host ---
# Use the container name when on the same docker network, or the host address.
INFLUX_URL=http://influxdb:8086
INFLUX_TOKEN=replace_me
INFLUX_ORG=home
INFLUX_BUCKET=octopus
# Optional measurement prefix (default octopus_)
# INFLUX_MEASUREMENT_PREFIX=octopus_

# --- Polling behaviour ---
POLL_PRICE_INTERVAL_MINUTES=30
POLL_CONSUMPTION_INTERVAL_MINUTES=15
# First run backfills this many days of history; later runs fetch ~2 days.
POLL_BACKFILL_DAYS=30
# Day-ahead horizon for Agile prices (Agile publishes ~16:00-20:00 for the next day).
POLL_LOOKAHEAD_DAYS=2
POLL_MIN_REQUEST_INTERVAL_MS=1000
POLL_REQUEST_TIMEOUT_MS=20000
POLL_MAX_RETRIES=3
POLLER_TIMEZONE=Europe/London
