# --- Octopus sites (same naming scheme as the MCP server) ---
# Comma-separated friendly names. Each needs its own key and account.
OCTOPUS_SITES=York,Newport Pagnell

OCTOPUS_SITE_YORK_NAME=York
OCTOPUS_SITE_YORK_API_KEY=sk_live_york_key
OCTOPUS_SITE_YORK_ACCOUNT_NUMBER=A-YORK0000

OCTOPUS_SITE_NEWPORT_PAGNELL_NAME=Newport Pagnell
OCTOPUS_SITE_NEWPORT_PAGNELL_API_KEY=sk_live_newport_key
OCTOPUS_SITE_NEWPORT_PAGNELL_ACCOUNT_NUMBER=A-NEWPORT0

# --- InfluxDB 2.x on the Proxmox host ---
# Use the container name when on the same docker network, or the host address.
INFLUX_URL=http://influxdb:8086
INFLUX_TOKEN=replace_me
INFLUX_ORG=home
INFLUX_BUCKET=octopus
# Optional measurement prefix (default octopus_)
# INFLUX_MEASUREMENT_PREFIX=octopus_

# --- Polling behaviour ---
POLL_PRICE_INTERVAL_MINUTES=30
POLL_CONSUMPTION_INTERVAL_MINUTES=15
# First run backfills this many days of history; later runs fetch ~2 days.
POLL_BACKFILL_DAYS=30
# Day-ahead horizon for Agile prices (Agile publishes ~16:00-20:00 for the next day).
# For Intelligent Octopus (IOG) sites, half-hourly prices are synthesised from the
# day/night unit-rate feeds and SmartFlex dispatch windows are logged automatically
# (octopus_intelligent_dispatch) — no extra configuration needed.
POLL_LOOKAHEAD_DAYS=2
# Market tariffs polled per site region (region letter derived from the site's own
# tariff code, e.g. F=Yorkshire, B=Eastern) for tariff comparison. Written to
# octopus_price with source=market. Comma-separated product codes; set empty to disable.
POLL_MARKET_IMPORT_PRODUCTS=AGILE-24-10-01
POLL_MARKET_EXPORT_PRODUCTS=AGILE-OUTGOING-19-05-13,OUTGOING-VAR-24-10-26,OUTGOING-PRIME-FIX-12M-26-06-23
POLL_MIN_REQUEST_INTERVAL_MS=1000
POLL_REQUEST_TIMEOUT_MS=20000
POLL_MAX_RETRIES=3
POLLER_TIMEZONE=Europe/London

# --- Battery day-ahead planner ---
# Comma-separated site slugs to plan for (empty disables). Uses the planner products
# below (must be included in POLL_MARKET_*_PRODUCTS) and writes a per-half-hour
# schedule to octopus_battery_plan: grid_charge -> discharge_morning -> solar_refill
# -> discharge_evening (down to the reserve) -> reserve (covers 19:00-23:00 load).
BATTERY_PLAN_SITES=york
BATTERY_CAPACITY_KWH=9
BATTERY_CHARGE_KW=4.4
BATTERY_DISCHARGE_KW=7.2
BATTERY_EFFICIENCY=0.9
# Cheap fixed-rate import window to model (e.g. Octopus Go 7p 00:30-05:30).
BATTERY_CHEAP_IMPORT_PENCE=7
BATTERY_CHEAP_IMPORT_WINDOW=00:30-05:30
# kWh held back from the evening dump to cover the 19:00-23:00 load before the
# next cheap window starts.
BATTERY_RESERVE_KWH=2
PLANNER_IMPORT_PRODUCT=AGILE-24-10-01
PLANNER_EXPORT_PRODUCT=AGILE-OUTGOING-19-05-13

# --- Daily tariff report ---
# Emails a daily replay of yesterday's actual flows under each tariff combination
# (current vs Go+VAR vs Go+Agile vs Go+Prime vs Agile+Agile) plus the optimised
# battery-dispatch uplift, with running totals. Sent at REPORT_TIME (UK) for the
# previous day via the LAN SMTP relay. Writes octopus_tariff_report points.
REPORT_ENABLED=true
REPORT_SITE=york
REPORT_SMTP_HOST=yorkstorj
REPORT_SMTP_PORT=25
REPORT_FROM=octopus-poller@soothill.com
REPORT_TO=darren@soothill.com
REPORT_TIME=07:30
# Go daytime rate used when the site is not yet on Go (pence, incl VAT).
REPORT_GO_DAY_PENCE=26.07

# --- Sunny Portal (Newport Pagnell SMA inverter) ---
# Headless login to Sunny Portal (sunnyportal.com) with the SMA ID (login email)
# to read the SB3000TL-20's 15-minute PV power curve and daily yield from the
# Analysis chart API. Writes sma_pv points tagged with SMA_SITE to InfluxDB.
# The Home Manager 1.0 is retired from SMA cloud, so grid flows are not available —
# PV generation only. Set SMA_ENABLED=false to disable the module.
SMA_ENABLED=true
SMA_USERNAME=darren@soothill.com
SMA_PASSWORD=
# PV System Identifier shown under Configuration -> PV System Properties (informational).
SMA_PLANT_ID=bc548d48-12df-4da2-85c6-3d997859c973
SMA_SITE=newport
SMA_POLL_INTERVAL_MINUTES=15
